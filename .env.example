# OpenAI is used only by local CLI tools, never by the Vite browser app.
# Copy this file to .env and set one of the key names below.
OPENAI_API_KEY=

# Backward-compatible alias supported by tools/asset-pipeline/asset_agent.mjs.
# Some shells cannot export names with hyphens, so prefer OPENAI_API_KEY.
OPENAI-KEY=

# The asset agent uses Structured Outputs to normalize briefs into AssetSpec JSON.
OPENAI_MODEL=gpt-5.5
OPENAI_REASONING_EFFORT=low
